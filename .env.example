# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=sk-...

# Optional: Gemini is preferred when GEMINI_API_KEY is set.
# With Gemini, OPENAI_API_KEY can be left empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional per-stage overrides (default to GEMINI_MODEL); free-tier quota is per model.
GEMINI_ENRICH_MODEL=
GEMINI_EVAL_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
